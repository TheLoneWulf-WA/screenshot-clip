#!/bin/zsh

# screenshot-clip: Auto-copy screenshots to clipboard
# https://github.com/TheLoneWulf-WA/screenshot-clip

WATCH_DIR="${SCREENSHOT_CLIP_DIR:-$HOME/Desktop}"
MAX_WAIT="${SCREENSHOT_CLIP_DELAY:-2.0}"
POLL_INTERVAL=0.05

if ! command -v fswatch &> /dev/null; then
    echo "Error: fswatch is required. Install it with: brew install fswatch"
    exit 1
fi

# Poll the file size until it stops growing, so we copy the fully-flushed
# PNG instead of guessing how long the write takes.
wait_for_stable_file() {
    local file="$1"
    local prev_size=-1
    local stable=0
    local iter=0
    local size
    local max_iter
    max_iter=$(awk -v m="$MAX_WAIT" -v p="$POLL_INTERVAL" 'BEGIN{ printf "%d", m/p }')

    while (( iter < max_iter )); do
        size=$(stat -f %z "$file" 2>/dev/null) || return
        if (( size > 0 )) && [[ "$size" == "$prev_size" ]]; then
            ((stable++))
            (( stable >= 2 )) && return
        else
            stable=0
        fi
        prev_size=$size
        sleep "$POLL_INTERVAL"
        ((iter++))
    done
}

echo "screenshot-clip: Watching $WATCH_DIR for new screenshots..."

# fswatch fires multiple events per screenshot (rename + xattr writes + Spotlight touch).
# Dedup by filename+mtime so we only copy once per actual screenshot.
last_file=""
last_mtime=""

fswatch -0 "$WATCH_DIR" | while IFS= read -r -d '' file; do
    filename=$(basename "$file")
    # Skip hidden files (macOS creates temp .Screenshot files before renaming)
    if [[ "$filename" == .* ]]; then
        continue
    fi
    if [[ "$filename" == *.png ]]; then
        mtime=$(stat -f %m "$file" 2>/dev/null) || continue
        if [[ "$filename" == "$last_file" && "$mtime" == "$last_mtime" ]]; then
            continue
        fi
        last_file="$filename"
        last_mtime="$mtime"
        wait_for_stable_file "$file"
        osascript -e "set the clipboard to (read (POSIX file \"$file\") as «class PNGf»)" 2>/dev/null
        if [[ $? -eq 0 ]]; then
            echo "Copied to clipboard: $filename"
        else
            echo "Failed to copy: $filename"
        fi
    fi
done
